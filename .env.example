# Client env — read by Vite only, and never sent to the browser beyond
# VITE_* (the QuizAPI key is not one of them: it lives in server/.env,
# see server/.env.example).
VITE_USE_MOCK_DATA=true

# PostHog (analytics + error monitoring). Production builds only, and
# only when set; never active in dev, mock mode, e2e or CI. The project
# key is public by design (it can write events, not read them).
# VITE_POSTHOG_KEY=
# Defaults to /ingest (rewritten to PostHog EU by vercel.json).
# VITE_POSTHOG_HOST=
# Created by Vercel CLI
VERCEL_OIDC_TOKEN=key
