{
  "name": "quiz-app",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --workspace @quiz-app/server",
    "dev:all": "concurrently -k -n web,api -c blue,magenta \"npm:dev\" \"npm:dev:server\"",
    "build": "tsc -b && vite build",
    "build:server": "npm run build --workspace @quiz-app/server",
    "size": "node scripts/check-bundle-size.mjs",
    "start:server": "npm run start --workspace @quiz-app/server",
    "typecheck:server": "npm run typecheck --workspace @quiz-app/server",
    "test:server": "npm run test --workspace @quiz-app/server",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"server/src/**/*.ts\" \"server/*.json\" \"*.config.ts\" \"server/*.config.mts\"",
    "preview": "vite preview",
    "pwa:assets": "pwa-assets-generator",
    "og:image": "node scripts/generate-og-image.mjs",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep \"@smoke\"",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/router-plugin": "^1.168.42",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "motion": "^14.0.0",
    "posthog-js": "^1.438.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/router-devtools": "^1.167.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
