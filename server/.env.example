# Server-side env — copy to server/.env (gitignored, never committed).
# Only the quizapi provider needs a key; the server boots without it and
# answers a typed `auth` error for that provider.
QUIZAPI_KEY=key

# Optional overrides (defaults are the live base URLs / 10 000 ms).
# QUIZAPI_BASE_URL=
# TRIVIA_BASE_URL=
# UPSTREAM_TIMEOUT_MS=

# Set only when the app is served from another origin — /api is
# same-origin in dev through the vite proxy.
# CORS_ORIGIN=

# PORT=3000

# Per-IP budget for the proxy (30 requests per 60 s by default) —
# deliberately below QuizAPI's own 60 req/min/IP. /health is exempt.
# THROTTLE_TTL_MS=
# THROTTLE_LIMIT=

# Number of trusted proxy hops in front of the server. Required behind
# a load balancer, otherwise every client shares the balancer's IP (and
# its throttle bucket). 1 behind a single proxy.
# TRUST_PROXY=
